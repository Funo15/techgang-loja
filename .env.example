# ============================================================
# TECHGANG — variáveis de ambiente
# Copia este ficheiro para .env e preenche os valores reais.
# O .env NUNCA vai para o git (está no .gitignore).
# ============================================================

# --- Stripe (modo test: chaves começam por sk_test_ / whsec_) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# URL pública da loja (para os redirects do Stripe)
BASE_URL=http://localhost:3002

# --- SMTP para emails transacionais (opcional — sem isto os emails
#     são saltados com um aviso no terminal, o resto funciona) ---
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=utilizador
SMTP_PASS=password
EMAIL_FROM="TechGang <hello@techgang.pt>"
EMAIL_ADMIN=brunomendesmkt21@gmail.com

# Painel admin (/admin)
ADMIN_PASSWORD=escolhe-uma-password-forte
